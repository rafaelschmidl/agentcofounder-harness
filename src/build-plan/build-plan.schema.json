{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentcofounder.local/schema/build-plan-0.1.json",
  "title": "System v0 BuildPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "product_spec_hash", "blocks", "custom_slots", "file_ownership", "dependencies", "routes", "exports", "requirement_mapping", "verification_obligations"],
  "properties": {
    "version": { "const": "0.1" },
    "product_spec_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "order", "config"],
        "properties": {
          "id": { "$ref": "#/$defs/blockId" },
          "version": { "$ref": "#/$defs/version" },
          "order": { "type": "integer", "minimum": 0 },
          "config": { "type": "object" }
        }
      }
    },
    "custom_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "requirement_ids", "required_interfaces", "permitted_paths"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "purpose": { "$ref": "#/$defs/text" },
          "requirement_ids": { "$ref": "#/$defs/idArray" },
          "required_interfaces": { "$ref": "#/$defs/stringArray" },
          "permitted_paths": { "$ref": "#/$defs/pathArray" }
        }
      }
    },
    "file_ownership": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner", "owner_id"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "owner": { "enum": ["BLOCK", "AGENT", "LINKER"] },
          "owner_id": { "$ref": "#/$defs/ownerId" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "development", "install_allowed"],
      "properties": {
        "runtime": { "$ref": "#/$defs/stringArray" },
        "development": { "$ref": "#/$defs/stringArray" },
        "install_allowed": { "const": false }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "component"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "component": { "$ref": "#/$defs/path" }
        }
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "names"],
        "properties": {
          "from": { "$ref": "#/$defs/path" },
          "names": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "requirement_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "block_ids", "custom_slot_ids"],
        "properties": {
          "requirement_id": { "$ref": "#/$defs/id" },
          "block_ids": { "$ref": "#/$defs/blockIdArray" },
          "custom_slot_ids": { "$ref": "#/$defs/idArray" }
        }
      }
    },
    "verification_obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "journey_id", "requirement_ids", "checks"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "journey_id": { "$ref": "#/$defs/id" },
          "requirement_ids": { "$ref": "#/$defs/idArray" },
          "checks": { "$ref": "#/$defs/nonEmptyStringArray" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "ownerId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
    "blockId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "text": { "type": "string", "minLength": 1 },
    "stringArray": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStringArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "idArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "blockIdArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/blockId" } },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$" },
    "pathArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
  }
}
