{
  "name": "agent-cofounder-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "challenge": "node --env-file-if-exists=.env.local --import tsx src/run-challenge.ts",
    "semantic-review": "node --env-file-if-exists=.env.local --import tsx src/run-semantic-review.ts",
    "validate:result": "node --import tsx src/validate-result.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "app:test": "npm --prefix app-template test -- --passWithNoTests",
    "app:build": "npm --prefix app-template run build",
    "check": "npm run typecheck && npm run test && npm run app:test && npm run app:build"
  },
  "dependencies": {
    "@bergetai/pi-provider": "0.3.2",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "ajv": "8.20.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
